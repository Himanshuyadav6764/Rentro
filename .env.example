# App
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.com

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rentro

# OTP JWT (phone/email sessions)
JWT_SECRET=change-me-with-strong-random-secret
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=change-me-with-otp-hash-secret

# NextAuth (optional: needed only if you use /api/auth/[...nextauth])
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=change-me-with-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase client (Phone OTP in frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase Admin (token verification in backend)
# Option A: full JSON as one line
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Option B: split values (use these if Option A is not used)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP (Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Rentro <no-reply@rentro.app>"

# OpenCage Geocoding
OPENCAGE_API_KEY=your-opencage-api-key

# Cloudinary (Image uploads)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# AI
GROQ_API_KEY=your-groq-api-key
NEXT_PUBLIC_IMAGE_AI_MODEL_URL=
NEXT_PUBLIC_IMAGE_AI_LABELS=
